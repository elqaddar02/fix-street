# ==============================================================================
# Production Environment Configuration: Madinup (fix-street)
# Copy this file to .env on your production VPS or Coolify application environment.
# ==============================================================================

APP_NAME="Madinup"
APP_ENV=production
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Your Cloudflare domain name (with https://)
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Bcrypt password hashing cost
BCRYPT_ROUNDS=12

# Production logging: logs warnings and errors only
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# Production Database (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=madinup_production
DB_USERNAME=madinup_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# ------------------------------------------------------------------------------
# Session & Cache (Secured over HTTPS / Cloudflare)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Enforce secure cookies over Cloudflare Full Strict SSL
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Mail Settings (Transactional emails: Verification, Password Reset)
# Use any SMTP service like Resend, Mailgun, Brevo, or Postmark.
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contact email receiving public feedback from the /help contact form
CONTACT_EMAIL="contact@yourdomain.com"

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
FEATURE_COMMENTS=false

# ------------------------------------------------------------------------------
# Vite Frontend Assets
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
